# Vercel / production frontend settings
# Point this at your deployed API, including the /api suffix.
VITE_API_URL=https://your-api-domain.com/api

# Must match the server SUPER_ADMIN_EMAIL to see the Reset Data page
# VITE_SUPER_ADMIN_EMAIL=abdulhasibzahid@gmail.com

# Optional shop details (defaults are used when omitted)
# VITE_SHOP_NAME=Vision Dates
# VITE_SHOP_LEGAL_NAME=Vision Dates
# VITE_SHOP_ADDRESS=Madinah, Saudi Arabia
# VITE_SHOP_PHONE=+966 50 000 0000
# VITE_SHOP_EMAIL=hello@visiondates.com
# VITE_SHOP_WEBSITE=www.visiondates.com
# VITE_SHOP_BIN=BIN 000000000-0000
