# Copy this file to server/.env before starting the API.
# For production, use long random secrets and your MongoDB Atlas connection string.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dates_shop
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Admin created by `npm run seed`
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@datesshop.com
ADMIN_PASSWORD=Admin@12345

# Demo employee created by `npm run seed`
EMPLOYEE_NAME=Shop Employee
EMPLOYEE_EMAIL=employee@datesshop.com
EMPLOYEE_PASSWORD=Employee@12345

# Set either of these to false to skip demo seed data
SEED_SAMPLE_EMPLOYEE=true
SEED_SAMPLE_PRODUCTS=true
